---
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import site from '../data/site.json';

const leistungen = [
  { icon: 'mdiCellphoneCog', titel: 'Smartphone-Reparaturen', text: 'Vom Displayschaden über Wasserschäden und Akkutausch bis zur aufwendigen Chip-Reparatur. 12 Monate Garantie auf alle verbauten Teile.' },
  { icon: 'mdiCloudSync', titel: 'Software & Daten', text: 'Software-Updates, Datenrettung, Datenübertragung oder sichere Löschung. Kostenloser Check und unverbindlicher Kostenvoranschlag, auch für Versicherungsfälle.' },
  { icon: 'mdiSwapHorizontalCircle', titel: 'An- und Verkauf', text: 'Lohnt sich die Reparatur nicht mehr? Wir kaufen Ihr altes Gerät an. Beim Kauf eines Smartphones bei uns übertragen wir Ihre Daten.' },
  { icon: 'mdiLeaf', titel: 'Nachhaltiges Zubehör', text: 'Hüllen von Pela Case und Glided aus pflanzlichen oder recycelten Materialien, Ladekabel sowie Panzerglas und Hydrogel-Schutzfolien.' },
];

const werte = [
  { titel: 'Nachhaltigkeit', text: 'Wir verwenden recycelte und aufbereitete Originalteile. Jede Reparatur spart Ressourcen und Elektroschrott.' },
  { titel: 'Persönlicher Service', text: 'Ehrliche Beratung: Wir sagen Ihnen offen, ob sich eine Reparatur lohnt oder ob ein gebrauchtes Gerät die bessere Wahl ist.' },
  { titel: '12 Monate Garantie', text: 'Auf alle verbauten Teile. Erreichbar per Telefon, WhatsApp, E-Mail oder direkt im Laden.' },
];

const kanten = [-10, -8, -6, -4, -2, 0, 2, 4, 6, 8, 10];

const zahlen = [
  { wert: 20, suffix: '+', label: 'Jahre Erfahrung' },
  { wert: 614, suffix: '+', label: 'iPhones verkauft über eBay seit 2018' },
  { wert: 100, suffix: ' %', label: 'Kundenzufriedenheit auf eBay' },
  { wert: 12, suffix: '', label: 'Monate Garantie' },
];
---
<Base>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__text">
        <p class="eyebrow">Handyreparatur in {site.city}</p>
        <h1>Ihr Handy kaputt? Wir machen es wieder <em>fair</em> ganz.</h1>
        <p class="lead">{site.tagline}. Reparaturen, gebrauchte Smartphones und nachhaltiges Zubehör zu fairen Preisen, mit 12 Monaten Garantie.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/reparatur/"><Icon name="mdiCalendarCheck" size={20} /> Preis & Termin online</a>
          <a class="btn btn--whatsapp" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener"><Icon name="mdiWhatsapp" size={20} /> WhatsApp schreiben</a>
        </div>
        <p class="hero__open" id="offen-status">Mo – Fr 12:00 – 17:00 Uhr</p>
      </div>
      <div class="hero__visual" aria-hidden="true">
        <div class="szene" id="szene">
          <div class="glow"></div>
          <div class="boden"></div>
          <div class="phone">
            {kanten.map((z) => <div class="phone__kante" style={`--z:${z}px`}></div>)}
            {kanten.filter((z) => Math.abs(z) <= 4).map((z) => (
              <>
                <span class="knopf knopf--aktion" style={`--z:${z}px`}></span>
                <span class="knopf knopf--laut1" style={`--z:${z}px`}></span>
                <span class="knopf knopf--laut2" style={`--z:${z}px`}></span>
                <span class="knopf knopf--power" style={`--z:${z}px`}></span>
              </>
            ))}
            <div class="phone__rueck"><span class="kamera"></span></div>
            <div class="phone__front">
              <div class="phone__screen">
                <div class="phone__status">
                  <span>12:00</span>
                  <span class="phone__icons"><Icon name="mdiSignalCellular3" size={13} /><Icon name="mdiWifi" size={13} /><Icon name="mdiBattery" size={15} /></span>
                </div>
                <div class="phone__insel"></div>
                <svg class="phone__crack" viewBox="0 0 182 392" preserveAspectRatio="none" aria-hidden="true">
                  <g fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <g class="riss-schatten" stroke="rgba(20,30,28,0.35)" stroke-width="2.2">
                      <path d="M118 150 L150 96 L182 70 M118 150 L170 168 L182 176 M118 150 L136 226 L150 300 L162 392 M118 150 L84 220 L40 262 L0 286 M118 150 L66 128 L18 92 L0 84 M118 150 L104 70 L96 0 M84 220 L92 300 L80 392 M66 128 L60 180 M150 96 L158 40 M136 226 L178 250" />
                    </g>
                    <g stroke="rgba(255,255,255,0.95)" stroke-width="1">
                      <path d="M118 150 L150 96 L182 70 M118 150 L170 168 L182 176 M118 150 L136 226 L150 300 L162 392 M118 150 L84 220 L40 262 L0 286 M118 150 L66 128 L18 92 L0 84 M118 150 L104 70 L96 0 M84 220 L92 300 L80 392 M66 128 L60 180 M150 96 L158 40 M136 226 L178 250" />
                      <path d="M118 150 L126 132 M118 150 L134 154 M118 150 L112 168 M118 150 L102 146 M126 132 L134 154 L112 168 L102 146 Z" stroke-width="0.7" opacity="0.7" />
                    </g>
                  </g>
                </svg>
                <div class="phone__logo"><img src="/img/logo.png" alt="" width="640" height="286" /></div>
                <div class="phone__glanz"></div>
              </div>
            </div>
          </div>
          <div class="bubble bubble--1"><Icon name="mdiBatteryCharging" size={20} /> Akku neu</div>
          <div class="bubble bubble--2"><Icon name="mdiRecycle" size={20} /> Originalteile</div>
          <div class="bubble bubble--3"><Icon name="mdiShieldCheck" size={20} /> 12 Mon. Garantie</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="leistungen">
    <div class="container">
      <p class="eyebrow">Leistungen</p>
      <h2>Was bieten wir an?</h2>
      <div class="grid grid--4" style="margin-top: 32px;">
        {leistungen.map((l) => (
          <article class="card tilt reveal">
            <div class="card__icon"><Icon name={l.icon as any} size={30} /></div>
            <h3>{l.titel}</h3>
            <p>{l.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container rabatt reveal">
      <div>
        <p class="eyebrow" style="color: var(--accent);">Rabattaktion</p>
        <h2>10 % Rabatt bei mehreren Reparaturen</h2>
        <p>Buchen Sie mehrere Reparaturen auf einmal und sparen Sie 10 % auf den Gesamtpreis.</p>
      </div>
      <a class="btn btn--accent" href="/reparatur/"><Icon name="mdiSale" size={20} /> Preise ansehen</a>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="online reveal">
        <div>
          <p class="eyebrow">Online-Reparaturauftrag</p>
          <h2>Preis sehen, Auftrag anlegen, fertig.</h2>
          <p class="lead">Wählen Sie Ihr Gerät und die Reparatur, sehen Sie sofort den Preis und legen Sie Ihren Auftrag online an, rund um die Uhr.</p>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href="/reparatur/">Zu Preisen & Online-Auftrag</a>
          <a class="btn btn--whatsapp" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">Lieber per WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Rethink, Reuse, Recycle!</p>
      <h2>Fair für Sie. Fair für die Umwelt.</h2>
      <p class="lead" style="max-width: 680px;">Unser Fokus auf Nachhaltigkeit spiegelt sich in unserer gesamten Geschäftsidee wider.</p>
      <div class="grid grid--3" style="margin-top: 32px;">
        {werte.map((w, i) => (
          <article class="wert reveal">
            <span class="wert__nr">0{i + 1}</span>
            <h3>{w.titel}</h3>
            <p>{w.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt" id="ueber-uns">
    <div class="container ueber">
      <div class="reveal">
        <p class="eyebrow">Wer sind wir?</p>
        <h2>Über 20 Jahre Erfahrung in der Elektronik</h2>
        <p>Sunardi ist bereits seit 1998 Informationselektroniker. In Indonesien führte er einen Smartphone-Laden mit mehreren Mitarbeitern. 2015 zog er in die Niederlande und gründete 2016 bei Eindhoven das Unternehmen „Fair Cellution“, das vor allem im B2B-Bereich tätig war.</p>
        <p>Als seine Partnerin Florence in ihre Heimat zurückkehren wollte, konzentrierte er sich auf den Online-Verkauf von Smartphones über eBay. Im Dezember 2024 eröffneten die beiden schließlich Fair Handy in Wadern-Nunkirchen, mit dem Ziel, Reparaturen fair, ehrlich und nachhaltig anzubieten.</p>
      </div>
      <div class="zahlen">
        {zahlen.map((z) => (
          <div class="zahl tilt reveal">
            <span class="zahl__wert" data-ziel={z.wert} data-suffix={z.suffix}>{z.wert}{z.suffix}</span>
            <span class="zahl__label">{z.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="shop tilt reveal">
        <div>
          <p class="eyebrow">Online-Shop</p>
          <h2>Gebrauchte Smartphones & Ersatzteile</h2>
          <p class="lead">Besuchen Sie Fair Handy und entdecken Sie unsere Auswahl an gebrauchten Smartphones und Reparaturteilen. Unser Online-Shop ist bald online!</p>
        </div>
        <span class="shop__badge"><Icon name="mdiStorefront" size={20} /> Bald online</span>
      </div>
    </div>
  </section>

  <section class="section" id="kontakt">
    <div class="container kontakt">
      <div class="reveal">
        <p class="eyebrow">Kontakt</p>
        <h2>Besuchen Sie uns</h2>
        <p class="lead">Kommen Sie einfach vorbei oder schreiben Sie uns. Der Check ist kostenlos und unverbindlich.</p>
        <ul class="kontakt__liste">
          <li><strong><Icon name="mdiMapMarker" size={20} /> Adresse</strong><span>{site.street}, {site.zip} {site.city}</span></li>
          <li><strong><Icon name="mdiPhone" size={20} /> Telefon & WhatsApp</strong><a href={`tel:${site.phoneIntl}`}>{site.phoneDisplay}</a></li>
          <li><strong><Icon name="mdiEmail" size={20} /> E-Mail</strong><a href={`mailto:${site.email}`}>{site.email}</a></li>
          {site.hours.map((h) => <li><strong><Icon name="mdiClockOutline" size={20} /> {h.days}</strong><span>{h.time}</span></li>)}
        </ul>
        <div class="btn-row">
          <a class="btn btn--whatsapp" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener"><Icon name="mdiWhatsapp" size={20} /> WhatsApp</a>
          <a class="btn btn--primary" href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${site.street}, ${site.zip} ${site.city}`)}`} target="_blank" rel="noopener"><Icon name="mdiMapMarkerPath" size={20} /> Route planen</a>
        </div>
      </div>
      <div class="karte reveal">
        <div class="karte__platzhalter" id="karte">
          <p><strong>Karte anzeigen?</strong></p>
          <p>Beim Laden der Karte werden Daten an Google übertragen.</p>
          <button type="button" class="btn btn--primary" id="karte-laden">Karte laden</button>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Zahlen hochzählen, wenn sie sichtbar werden
  const zaehler = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      const el = e.target as HTMLElement;
      const ziel = Number(el.dataset.ziel);
      const suffix = el.dataset.suffix ?? '';
      const start = performance.now();
      const dauer = 1200;
      const tick = (t: number) => {
        const p = Math.min((t - start) / dauer, 1);
        el.textContent = Math.round(ziel * (1 - Math.pow(1 - p, 3))) + suffix;
        if (p < 1) requestAnimationFrame(tick);
      };
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) requestAnimationFrame(tick);
      zaehler.unobserve(el);
    }
  }, { threshold: 0.5 });
  document.querySelectorAll('.zahl__wert').forEach((el) => zaehler.observe(el));

  // Geöffnet / geschlossen (Zeitzone Berlin)
  const status = document.getElementById('offen-status');
  if (status) {
    const teile = new Intl.DateTimeFormat('de-DE', { timeZone: 'Europe/Berlin', weekday: 'short', hour: '2-digit', minute: '2-digit', hour12: false }).formatToParts(new Date());
    const tag = teile.find((p) => p.type === 'weekday')?.value ?? '';
    const stunde = Number(teile.find((p) => p.type === 'hour')?.value);
    const werktag = ['Mo', 'Di', 'Mi', 'Do', 'Fr'].includes(tag.replace('.', ''));
    const offen = werktag && stunde >= 12 && stunde < 17;
    status.classList.add(offen ? 'is-offen' : 'is-zu');
    status.textContent = (offen ? 'Jetzt geöffnet · ' : 'Gerade geschlossen · ') + 'Mo – Fr 12:00 – 17:00 Uhr';
  }

  // Google-Karte erst nach Zustimmung laden (DSGVO)
  document.getElementById('karte-laden')?.addEventListener('click', () => {
    const box = document.getElementById('karte');
    if (!box) return;
    box.innerHTML = '<iframe title="Karte: Fair Handy" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps?q=Weiskircher+Str.+9,+66687+Wadern-Nunkirchen&output=embed"></iframe>';
  });
</script>

<style>
  .hero { padding: 72px 0 96px; background: radial-gradient(circle at 85% 20%, var(--green-100), transparent 55%); overflow: hidden; }
  .hero__grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 48px; align-items: center; }
  .hero h1 em { font-style: normal; background: linear-gradient(120deg, var(--green-500), var(--secondary)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .hero .lead { margin-bottom: 28px; }
  .hero__open { margin-top: 20px; font-size: 0.95rem; color: var(--ink-soft); display: flex; align-items: center; gap: 8px; }
  .hero__open::before { content: ''; width: 10px; height: 10px; border-radius: 50%; background: var(--ink-soft); }
  .hero__open.is-offen::before { background: #2fbf71; box-shadow: 0 0 0 4px rgba(47, 191, 113, 0.2); }
  .hero__open.is-zu::before { background: #d9534f; }

  .hero__visual { position: relative; height: 460px; perspective: 1100px; }
  .szene { position: absolute; inset: 0; transform-style: preserve-3d; transform: rotateX(var(--sx, 0deg)) rotateY(var(--sy, 0deg)); transition: transform 0.25s ease-out; }
  .glow { position: absolute; left: 50%; top: 50%; width: 360px; height: 360px; margin: -180px 0 0 -180px; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--secondary), transparent 55%), transparent 65%); transform: translateZ(-120px); filter: blur(10px); }
  .boden { position: absolute; left: 50%; bottom: 6px; width: 220px; height: 34px; margin-left: -110px; border-radius: 50%; background: radial-gradient(ellipse, rgba(var(--schatten), 0.35), transparent 70%); filter: blur(6px); animation: boden 6s ease-in-out infinite; }

  @property --dreh { syntax: '<angle>'; inherits: true; initial-value: -22deg; }
  .phone { position: absolute; left: 50%; top: 50%; width: 200px; height: 410px; margin: -205px 0 0 -100px; transform-style: preserve-3d; transform: rotateX(10deg) rotateY(var(--dreh)) rotateZ(-5deg); animation: drehen 9s ease-in-out infinite, schweben 6s ease-in-out infinite; }
  .phone__kante, .phone__rueck, .phone__front { position: absolute; inset: 0; border-radius: 40px; }
  /* Titanrahmen: viele Schichten hintereinander ergeben eine massive Kante */
  .phone__kante { transform: translateZ(var(--z)); background: linear-gradient(90deg, #2b3034 0%, #8d969c 12%, #3d4347 30%, #b9c1c6 55%, #474e53 78%, #a3abb0 92%, #2b3034 100%); }
  .phone__rueck { transform: translateZ(-11px) rotateY(180deg); background: linear-gradient(150deg, #3b4246, #23292c); backface-visibility: hidden; }
  .kamera { position: absolute; top: 16px; left: 16px; width: 70px; height: 70px; border-radius: 20px; background: #1a1f22; box-shadow: inset 0 0 0 2px #4a5156; }
  .knopf { position: absolute; width: 4px; border-radius: 2px; background: linear-gradient(90deg, #6f777c, #c3cacf, #5b6266); transform: translateZ(var(--z)); }
  .knopf--aktion { left: -3px; top: 86px; height: 26px; }
  .knopf--laut1 { left: -3px; top: 128px; height: 44px; }
  .knopf--laut2 { left: -3px; top: 182px; height: 44px; }
  .knopf--power { right: -3px; top: 140px; height: 70px; }
  .phone__front { transform: translateZ(11px); background: #07090a; padding: 9px; box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.18), inset 0 0 0 3px #1b1f21; }
  .phone__screen { position: relative; height: 100%; border-radius: 31px; overflow: hidden; background:
    radial-gradient(circle at 20% 15%, color-mix(in srgb, var(--secondary), transparent 35%), transparent 45%),
    radial-gradient(circle at 85% 80%, color-mix(in srgb, var(--green-500), transparent 55%), transparent 50%),
    linear-gradient(170deg, #ffffff, var(--green-100) 55%, color-mix(in srgb, var(--secondary), white 40%)); }
  .phone__status { position: absolute; top: 10px; left: 20px; right: 14px; display: flex; justify-content: space-between; align-items: center; font-size: 12px; font-weight: 600; color: var(--green-900); z-index: 3; }
  .phone__icons { display: inline-flex; gap: 3px; align-items: center; }
  .phone__insel { position: absolute; top: 9px; left: 50%; width: 56px; height: 18px; margin-left: -28px; border-radius: 12px; background: #000; z-index: 4; }
  .phone__crack { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 2; animation: crack 6s ease-in-out infinite; }
  .phone__logo { position: absolute; left: 50%; top: 46%; width: 150px; padding: 14px 12px; translate: -50% -50%; border-radius: 18px; background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(6px); box-shadow: 0 12px 30px rgba(var(--schatten), 0.18); z-index: 2; animation: fix 6s ease-in-out infinite; }
  .phone__logo img { width: 100%; height: auto; }
  .phone__glanz { position: absolute; inset: -40%; background: linear-gradient(105deg, transparent 40%, rgba(255, 255, 255, 0.35) 48%, transparent 56%); z-index: 5; animation: glanz 9s ease-in-out infinite; pointer-events: none; }
  .bubble { display: inline-flex; align-items: center; gap: 6px; position: absolute; background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(6px); padding: 10px 16px; border-radius: 999px; box-shadow: var(--shadow-hoch); font-weight: 600; font-size: 0.9rem; white-space: nowrap; animation: schweben 5s ease-in-out infinite; }
  .bubble--1 { top: 40px; left: 0; transform: translateZ(110px); }
  .bubble--2 { top: 190px; right: -10px; transform: translateZ(140px); animation-delay: -1.5s; }
  .bubble--3 { bottom: 40px; left: 10px; transform: translateZ(120px); animation-delay: -3s; }
  @keyframes drehen { 0%, 100% { --dreh: -32deg; } 50% { --dreh: 12deg; } }
  @keyframes glanz { 0%, 100% { translate: -30% 0; } 50% { translate: 30% 0; } }
  @keyframes schweben { 0%, 100% { translate: 0 0; } 50% { translate: 0 -14px; } }
  @keyframes boden { 0%, 100% { scale: 1; opacity: 1; } 50% { scale: 0.85; opacity: 0.7; } }
  @keyframes crack { 0%, 35% { opacity: 1; } 50%, 90% { opacity: 0; } 100% { opacity: 1; } }
  @keyframes fix { 0%, 40% { opacity: 0; scale: 0.85; } 55%, 88% { opacity: 1; scale: 1; } 100% { opacity: 0; scale: 0.85; } }
  @media (prefers-reduced-motion: reduce) {
    .phone, .bubble, .phone__crack, .phone__logo, .phone__glanz, .boden { animation: none; }
    .phone__crack { opacity: 0; }
    .szene { transform: none; }
  }

  .online { display: grid; grid-template-columns: 1.3fr 1fr; gap: 32px; align-items: center; }
  .online .lead { margin-bottom: 0; }
  @media (max-width: 860px) { .online { grid-template-columns: 1fr; } }
  .rabatt { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; }
  .rabatt p { margin: 0; }

  .wert { padding-top: 20px; border-top: 3px solid var(--green-500); }
  .wert__nr { font-family: 'Poppins', system-ui, sans-serif; font-size: 2.4rem; color: var(--green-100); -webkit-text-stroke: 1px var(--green-500); display: block; margin-bottom: 8px; }
  .wert p { color: var(--ink-soft); }

  .shop { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 36px; border-radius: 24px; border: 2px dashed rgba(var(--schatten), 0.18); background: linear-gradient(160deg, #ffffff, color-mix(in srgb, var(--green-100), white 55%)); box-shadow: var(--shadow); position: relative; }
  .shop h2 { margin-top: 0; }
  .shop__badge { display: inline-flex; align-items: center; gap: 6px; flex-shrink: 0; box-shadow: 0 4px 0 color-mix(in srgb, var(--accent), black 30%), 0 10px 18px rgba(var(--schatten), 0.25); padding: 0.5em 1.1em; border-radius: 999px; background: var(--accent); color: var(--green-900); font-weight: 600; }
  @media (max-width: 700px) { .shop { flex-direction: column; align-items: flex-start; padding: 24px; } }
  .ueber { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  .zahlen { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .zahl { position: relative; background: linear-gradient(160deg, #ffffff, color-mix(in srgb, var(--green-100), white 55%)); border-radius: var(--radius); padding: 24px; box-shadow: var(--shadow); }
  .zahl__wert { text-shadow: 0 1px 0 color-mix(in srgb, var(--secondary), white 55%), 0 2px 0 color-mix(in srgb, var(--secondary), white 40%), 0 3px 0 color-mix(in srgb, var(--secondary), white 25%), 0 8px 14px rgba(var(--schatten), 0.18); }
  .zahl__wert { display: block; font-family: 'Poppins', system-ui, sans-serif; font-size: 2.6rem; color: var(--green-700); line-height: 1; margin-bottom: 8px; }
  .zahl__label { color: var(--ink-soft); font-size: 0.95rem; }

  .kontakt { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .kontakt__liste strong { display: inline-flex; align-items: center; gap: 8px; }
  .kontakt__liste strong :global(.icon) { color: var(--green-500); }
  .bubble :global(.icon) { color: var(--green-500); }
  .kontakt__liste { list-style: none; padding: 0; margin: 0 0 28px; display: grid; gap: 12px; }
