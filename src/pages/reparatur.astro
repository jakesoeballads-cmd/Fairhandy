---
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import RepairWidget from '../components/RepairWidget.astro';
---
<Base title="Reparatur-Preise & Online-Auftrag" description="Preise für die Reparatur Ihres Smartphones oder Tablets bei Fair Handy in Wadern-Nunkirchen sehen und direkt online einen Reparaturauftrag erstellen.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Preise & Online-Auftrag</p>
      <h1>Was kostet meine Reparatur?</h1>
      <p class="lead" style="margin-bottom: 32px;">Wählen Sie Ihr Gerät und die Reparatur. Sie sehen sofort den Preis und können Ihren Auftrag direkt online anlegen, auch außerhalb unserer Öffnungszeiten. Der Check vor Ort ist kostenlos und unverbindlich.</p>
      <RepairWidget />
      <div class="grid grid--3" style="margin-top: 48px;">
        <div class="card tilt"><div class="card__icon"><Icon name="mdiShieldCheck" size={30} /></div><h3>12 Monate Garantie</h3><p>Auf alle verbauten Teile.</p></div>
        <div class="card tilt"><div class="card__icon"><Icon name="mdiRecycle" size={30} /></div><h3>Nachhaltige Teile</h3><p>Recycelte und aufbereitete Originalteile.</p></div>
        <div class="card tilt"><div class="card__icon"><Icon name="mdiSale" size={30} /></div><h3>10 % Mehrfachrabatt</h3><p>Bei mehreren Reparaturen auf einmal.</p></div>
      </div>
    </div>
  </section>
</Base>
