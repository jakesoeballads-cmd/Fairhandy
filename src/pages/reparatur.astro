---
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import RepairWidget from '../components/RepairWidget.astro';
import site from '../data/site.json';

const waText = encodeURIComponent('Hallo Fair Handy, was kostet die Reparatur für mein Gerät? Modell: … Problem: …');
---
<Base title={site.bookingAktiv ? "Reparatur-Preise & Online-Auftrag" : "Reparatur-Preise anfragen"} description="Preise für die Reparatur Ihres Smartphones oder Tablets bei Fair Handy in Wadern-Nunkirchen sehen und direkt online einen Reparaturauftrag erstellen.">
  <section class="section">
    <div class="container">
      <h1>Was kostet meine Reparatur?</h1>
      {site.bookingAktiv ? (
        <>
          <p class="lead" style="margin-bottom: 32px;">Wählen Sie Ihr Gerät und die Reparatur. Sie sehen sofort den Preis und können Ihren Auftrag direkt online anlegen, auch außerhalb unserer Öffnungszeiten. Der Check vor Ort ist kostenlos und unverbindlich.</p>
          <RepairWidget />
        </>
      ) : (
        <>
          <p class="lead" style="margin-bottom: 32px;">Der Check vor Ort ist kostenlos und unverbindlich.</p>
          <div class="pause card">
            <div class="card__icon"><Icon name="mdiTagHeart" size={30} /></div>
            <div>
              <h2>Unsere Preise werden gerade aktualisiert</h2>
              <p>Die Online-Preisliste und der Online-Auftrag sind deshalb kurz nicht verfügbar. Schreiben Sie uns Ihr Gerät und das Problem per WhatsApp oder rufen Sie an, dann nennen wir Ihnen den Preis direkt.</p>
              <div class="btn-row" style="margin-top: 20px;">
                <a class="btn btn--whatsapp" href={`https://wa.me/${site.whatsapp}?text=${waText}`} target="_blank" rel="noopener"><Icon name="mdiWhatsapp" size={20} /> Preis per WhatsApp anfragen</a>
                <a class="btn btn--primary" href={`tel:${site.phoneIntl}`}><Icon name="mdiPhone" size={20} /> {site.phoneDisplay}</a>
              </div>
            </div>
          </div>
        </>
      )}
      <ul class="fakten">
        <li><Icon name="mdiShieldCheck" size={24} /><span><strong>12 Monate Garantie</strong> auf alle Reparaturen</span></li>
        <li><Icon name="mdiRecycle" size={24} /><span><strong>Nachhaltige Teile:</strong> recycelte und aufbereitete Originalteile</span></li>
        <li><Icon name="mdiSale" size={24} /><span><strong>10 % Rabatt</strong> bei mehreren Reparaturen auf einmal</span></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .pause { display: flex; gap: 24px; align-items: flex-start; padding: 36px; }
  .pause .card__icon { flex-shrink: 0; }
  .pause h2 { font-size: clamp(1.4rem, 3vw, 1.9rem); }
  /* Kurze Fakten statt drei gleicher Karten: der Hinweis oben bleibt das Wichtigste */
  .fakten { list-style: none; padding: 0; margin: 40px 0 0; display: flex; flex-wrap: wrap; gap: 16px 36px; }
  .fakten li { display: flex; align-items: center; gap: 10px; color: var(--ink-soft); }
  .fakten :global(.icon) { color: var(--green-500); flex-shrink: 0; }
  .fakten strong { color: var(--ink); }
  @media (max-width: 600px) { .pause { flex-direction: column; padding: 24px; } }
</style>
