---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
---
<Base title="Impressum">
  <section class="section">
    <div class="container prose">
      <h1>Impressum</h1>
      <h2>Angaben gemäß § 5 DDG</h2>
      <p>{site.owner}<br />{site.name}<br />{site.street}<br />{site.zip} {site.city}</p>
      <h2>Kontakt</h2>
      <p>Telefon: <a href={`tel:${site.phoneIntl}`}>{site.phoneDisplay}</a><br />E-Mail: <a href={`mailto:${site.email}`}>{site.email}</a></p>
      <h2>Umsatzsteuer-ID</h2>
      <p>Umsatzsteuer-Identifikationsnummer gemäß § 27 a Umsatzsteuergesetz:<br />{site.vatId}</p>
      <h2>Verbraucherstreitbeilegung</h2>
      <p>Wir sind nicht bereit oder verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.</p>
    </div>
  </section>
</Base>
