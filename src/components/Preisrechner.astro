---
import preise from '../data/preise.json';
import site from '../data/site.json';
---
<div class="rechner" data-whatsapp={site.whatsapp}>
  <script type="application/json" id="preisdaten" set:html={JSON.stringify(preise)} />

  <ol class="schritte">
    <li class="schritt">
      <p class="schritt__titel"><span>1</span> Marke wählen</p>
      <div class="chips" data-feld="marke">
        {preise.marken.map((m) => (
          <button type="button" class="chip" data-wert={m.name}>{m.name}</button>
        ))}
      </div>
    </li>

    <li class="schritt" data-schritt="modell" hidden>
      <p class="schritt__titel"><span>2</span> Modell wählen</p>
      <select class="auswahl" aria-label="Modell">
        <option value="">Bitte Modell wählen …</option>
      </select>
    </li>

    <li class="schritt" data-schritt="schaden" hidden>
      <p class="schritt__titel"><span>3</span> Was ist kaputt? <small>(Mehrfachauswahl möglich)</small></p>
      <div class="schaeden">
        {preise.schaeden.map((s) => (
          <label class="schaden">
            <input type="checkbox" value={s.id} />
            <span class="schaden__icon" aria-hidden="true">{s.icon}</span>
            <span>{s.label}</span>
          </label>
        ))}
      </div>
    </li>
  </ol>

  <div class="ergebnis" aria-live="polite" hidden>
    <div>
      <p class="ergebnis__geraet"></p>
      <p class="ergebnis__preis"></p>
      <p class="ergebnis__hinweis"></p>
    </div>
    <div class="btn-row">
      <a class="btn btn--whatsapp ergebnis__wa" target="_blank" rel="noopener">Per WhatsApp anfragen</a>
      <a class="btn btn--ghost" href={`tel:${site.phoneIntl}`}>Anrufen</a>
    </div>
  </div>
</div>

<script>
  type Modell = { name: string; preise: Record<string, number | null> };
  type Daten = {
    rabattMehrfach: number;
    schaeden: { id: string; label: string }[];
    marken: { name: string; modelle: Modell[] }[];
  };

  const root = document.querySelector<HTMLElement>('.rechner');
  if (root) {
    const daten: Daten = JSON.parse(root.querySelector('#preisdaten')!.textContent!);
    const wa = root.dataset.whatsapp;
    const schrittModell = root.querySelector<HTMLElement>('[data-schritt="modell"]')!;
    const schrittSchaden = root.querySelector<HTMLElement>('[data-schritt="schaden"]')!;
    const select = schrittModell.querySelector('select')!;
    const boxes = [...root.querySelectorAll<HTMLInputElement>('.schaden input')];
    const ergebnis = root.querySelector<HTMLElement>('.ergebnis')!;
    const euro = new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' });

    let marke: (typeof daten.marken)[number] | undefined;

    root.querySelectorAll<HTMLButtonElement>('.chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        root.querySelectorAll('.chip').forEach((c) => c.classList.remove('is-active'));
        chip.classList.add('is-active');
        marke = daten.marken.find((m) => m.name === chip.dataset.wert);
        select.innerHTML = '<option value="">Bitte Modell wählen …</option>' +
          (marke?.modelle ?? []).map((m, i) => `<option value="${i}">${m.name}</option>`).join('');
        if (marke?.modelle.length === 1) select.value = '0';
        schrittModell.hidden = false;
        update();
      });
    });

    select.addEventListener('change', update);
    boxes.forEach((b) => b.addEventListener('change', update));

    function update() {
      const modell = marke && select.value !== '' ? marke.modelle[Number(select.value)] : undefined;
      schrittSchaden.hidden = !modell;
      const gewaehlt = boxes.filter((b) => b.checked).map((b) => b.value);
      if (!modell || gewaehlt.length === 0) {
        ergebnis.hidden = true;
        return;
      }

      const labels = gewaehlt.map((id) => daten.schaeden.find((s) => s.id === id)?.label ?? id);
      const einzel = gewaehlt.map((id) => modell.preise[id]);
      const allesBekannt = einzel.every((p) => typeof p === 'number');
      const mehrfach = gewaehlt.length > 1;

      root!.querySelector('.ergebnis__geraet')!.textContent = `${modell.name}: ${labels.join(', ')}`;
      const preisEl = root!.querySelector('.ergebnis__preis')!;
      const hinweisEl = root!.querySelector('.ergebnis__hinweis')!;

      if (allesBekannt) {
        const summe = (einzel as number[]).reduce((a, b) => a + b, 0);
        const endpreis = mehrfach ? summe * (1 - daten.rabattMehrfach) : summe;
        preisEl.textContent = `ca. ${euro.format(endpreis)}`;
        hinweisEl.textContent = mehrfach
          ? `Inklusive ${Math.round(daten.rabattMehrfach * 100)} % Rabatt für mehrere Reparaturen. Unverbindliche Schätzung, 12 Monate Garantie auf verbaute Teile.`
          : 'Unverbindliche Schätzung, 12 Monate Garantie auf verbaute Teile.';
      } else {
        preisEl.textContent = 'Preis auf Anfrage';
        hinweisEl.textContent = mehrfach
          ? `Kostenloser Check vor Ort. Bei mehreren Reparaturen sparen Sie ${Math.round(daten.rabattMehrfach * 100)} % auf den Gesamtpreis.`
          : 'Kostenloser und unverbindlicher Check vor Ort – wir nennen Ihnen den genauen Preis.';
      }

      const text = `Hallo Fair Handy, ich interessiere mich für eine Reparatur: ${modell.name} – ${labels.join(', ')}. Was würde das kosten?`;
      root!.querySelector<HTMLAnchorElement>('.ergebnis__wa')!.href = `https://wa.me/${wa}?text=${encodeURIComponent(text)}`;
      ergebnis.hidden = false;
    }
  }
</script>

<style>
  .rechner { background: var(--white); border-radius: 24px; padding: clamp(20px, 4vw, 40px); box-shadow: var(--shadow); }
  .schritte { list-style: none; margin: 0; padding: 0; display: grid; gap: 28px; }
  .schritt__titel { font-weight: 700; display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
  .schritt__titel span { width: 30px; height: 30px; border-radius: 50%; background: var(--green-700); color: var(--white); display: grid; place-items: center; font-size: 0.9rem; flex-shrink: 0; }
  .schritt__titel small { font-weight: 400; color: var(--ink-soft); }
  .chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .chip { padding: 0.7em 1.3em; border-radius: 999px; border: 2px solid var(--green-100); background: var(--sand-50); font: inherit; font-weight: 600; cursor: pointer; transition: all 0.15s ease; }
  .chip:hover { border-color: var(--green-500); }
  .chip.is-active { background: var(--green-700); border-color: var(--green-700); color: var(--white); }
  .auswahl { width: 100%; max-width: 420px; padding: 0.8em 1em; border-radius: 12px; border: 2px solid var(--green-100); font: inherit; background: var(--sand-50); }
  .schaeden { display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); }
  .schaden { display: flex; align-items: center; gap: 10px; padding: 14px; border-radius: 14px; border: 2px solid var(--green-100); cursor: pointer; transition: all 0.15s ease; background: var(--sand-50); }
  .schaden:hover { border-color: var(--green-500); }
  .schaden:has(input:checked) { border-color: var(--green-700); background: var(--green-100); }
  .schaden input { accent-color: var(--green-700); width: 18px; height: 18px; }
  .schaden__icon { font-size: 1.3rem; }
  .ergebnis { margin-top: 32px; padding: 24px; border-radius: 18px; background: var(--green-900); color: #dfeee6; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; animation: auf 0.3s ease; }
  .ergebnis[hidden] { display: none; }
  .ergebnis__geraet { margin: 0 0 4px; font-size: 0.95rem; }
  .ergebnis__preis { font-family: 'Fraunces', Georgia, serif; font-size: 2rem; color: var(--white); margin: 0 0 4px; }
  .ergebnis__hinweis { margin: 0; font-size: 0.9rem; max-width: 460px; }
  .ergebnis .btn--ghost { color: var(--white); }
  @keyframes auf { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
</style>
