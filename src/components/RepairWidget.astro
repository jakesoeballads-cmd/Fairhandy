---
import site from '../data/site.json';
---
<div class="widget">
  <div class="widget__kopf">
    <p>Gerät wählen, Reparatur auswählen, Preis sehen und direkt einen Termin buchen.</p>
    <a class="btn btn--ghost" href={site.bookingUrl} target="_blank" rel="noopener">In neuem Fenster öffnen ↗</a>
  </div>
  <iframe
    src={site.bookingUrl}
    title="Online-Reparaturauftrag – Fair Handy"
    loading="lazy"
    allow="clipboard-write"
  ></iframe>
</div>

<style>
  .widget { background: var(--white); border-radius: 24px; box-shadow: var(--shadow); overflow: hidden; }
  .widget__kopf { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; padding: 18px 24px; border-bottom: 1px solid rgba(18, 53, 42, 0.08); }
  .widget__kopf p { margin: 0; color: var(--ink-soft); }
  .widget__kopf .btn { padding: 0.5em 1.1em; font-size: 0.9rem; color: var(--green-700); }
  .widget iframe { display: block; width: 100%; height: 900px; border: 0; }
  @media (max-width: 640px) { .widget iframe { height: 1000px; } }
</style>
