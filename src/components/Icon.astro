---
// Material Design Icons (https://pictogrammers.com/library/mdi/) als Inline-SVG, ohne externe Anfragen
import * as mdi from '@mdi/js';

interface Props { name: keyof typeof mdi; size?: number; class?: string }
const { name, size = 24, class: className } = Astro.props;
---
<svg class:list={['icon', className]} viewBox="0 0 24 24" width={size} height={size} aria-hidden="true"><path fill="currentColor" d={mdi[name]} /></svg>
