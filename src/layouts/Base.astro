---
import '@fontsource/poppins/latin-400.css';
import '@fontsource/poppins/latin-500.css';
import '@fontsource/poppins/latin-600.css';
import '@fontsource/poppins/latin-700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import Icon from '../components/Icon.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = 'Fair Handy in Wadern-Nunkirchen: Smartphone- und Tablet-Reparatur, An- und Verkauf gebrauchter Handys und nachhaltiges Zubehör. Bis zu 12 Monate Garantie.',
} = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} – Handyreparatur in Wadern-Nunkirchen`;

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'MobilePhoneStore',
  name: site.name,
  description,
  url: 'https://fairhandy.eu/',
  telephone: site.phoneIntl,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.street,
    postalCode: site.zip,
    addressLocality: site.city,
    addressCountry: 'DE',
  },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '12:00',
    closes: '17:00',
  }],
};
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="de_DE" />
    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
  </head>
  <body>
    <Header />
    <main id="inhalt">
      <slot />
    </main>
    <Footer />
    <a class="wa-float" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" aria-label="Per WhatsApp schreiben">
      <Icon name="mdiWhatsapp" size={30} />
    </a>
    <script>
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            io.unobserve(e.target);
          }
        }
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // 3D-Tiefe: Karten kippen mit der Maus, die Hero-Szene folgt dem Zeiger
      const bewegung = !matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (bewegung && matchMedia('(hover: hover) and (pointer: fine)').matches) {
        document.querySelectorAll<HTMLElement>('.tilt').forEach((el) => {
          el.addEventListener('pointermove', (ev) => {
            const r = el.getBoundingClientRect();
            const x = (ev.clientX - r.left) / r.width;
            const y = (ev.clientY - r.top) / r.height;
            el.style.setProperty('--ry', `${(x - 0.5) * 14}deg`);
            el.style.setProperty('--rx', `${(0.5 - y) * 14}deg`);
            el.style.setProperty('--gx', `${x * 100}%`);
            el.style.setProperty('--gy', `${y * 100}%`);
            el.classList.add('is-tilting');
          });
          el.addEventListener('pointerleave', () => {
            el.style.removeProperty('--rx');
            el.style.removeProperty('--ry');
            el.classList.remove('is-tilting');
          });
        });
        const szene = document.getElementById('szene');
        if (szene) {
          window.addEventListener('pointermove', (ev) => {
            const x = ev.clientX / innerWidth - 0.5;
            const y = ev.clientY / innerHeight - 0.5;
            szene.style.setProperty('--sy', `${x * 18}deg`);
            szene.style.setProperty('--sx', `${-y * 12}deg`);
          }, { passive: true });
        }
      }
    </script>
    <style>
      .wa-float {
        position: fixed; right: 20px; bottom: 20px; z-index: 50;
        width: 58px; height: 58px; border-radius: 50%;
        display: grid; place-items: center;
        background: #25d366; color: #fff;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
        transition: transform 0.15s ease;
      }
      .wa-float:hover { transform: scale(1.08); }
    </style>
  </body>
</html>
