---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = 'Fair Handy in Wadern-Nunkirchen: Smartphone- und Tablet-Reparatur, An- und Verkauf gebrauchter Handys und nachhaltiges Zubehör. 12 Monate Garantie.',
} = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} – Handyreparatur in Wadern-Nunkirchen`;

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'MobilePhoneStore',
  name: site.name,
  description,
  url: 'https://fairhandy.eu/',
  telephone: site.phoneIntl,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.street,
    postalCode: site.zip,
    addressLocality: site.city,
    addressCountry: 'DE',
  },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '12:00',
    closes: '17:00',
  }],
};
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="de_DE" />
    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
  </head>
  <body>
    <Header />
    <main id="inhalt">
      <slot />
    </main>
    <Footer />
    <a class="wa-float" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" aria-label="Per WhatsApp schreiben">
      <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3Zm0 23.7c-2 0-4-.6-5.7-1.6l-.4-.2-3.9 1 1-3.8-.3-.4A10.7 10.7 0 1 1 16 26.7Zm5.9-8c-.3-.2-1.9-1-2.2-1-.3-.2-.5-.2-.7.1l-1 1.3c-.2.2-.4.2-.7 0a8.8 8.8 0 0 1-4.4-3.8c-.3-.6.3-.5 1-1.7.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6 0-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.5c.2.2 2.4 3.6 5.7 5 2.1 1 3 1 4 .8.7-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5l-.6-.3Z"/></svg>
    </a>
    <script>
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            io.unobserve(e.target);
          }
        }
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
    <style>
      .wa-float {
        position: fixed; right: 20px; bottom: 20px; z-index: 50;
        width: 58px; height: 58px; border-radius: 50%;
        display: grid; place-items: center;
        background: #25d366; color: #fff;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
        transition: transform 0.15s ease;
      }
      .wa-float:hover { transform: scale(1.08); }
    </style>
  </body>
</html>
